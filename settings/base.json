{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "description": "Base configuration for Claude Code projects",
  "model": "sonnet",
  "permissions": {
    "bash": "ask",
    "read": "always-allow",
    "write": "ask",
    "edit": "ask"
  },
  "hooks": {
    "pre-bash": null,
    "post-bash": null,
    "pre-write": null,
    "post-write": null
  },
  "memory": [],
  "enabledSkills": [],
  "customSettings": {
    "autoSave": true,
    "gitAutoStage": false,
    "verbose": false
  }
}
