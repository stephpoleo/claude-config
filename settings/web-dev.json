{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "description": "Configuration preset for web development projects",
  "extends": "./base.json",
  "model": "sonnet",
  "permissions": {
    "bash": "always-allow",
    "read": "always-allow",
    "write": "ask",
    "edit": "ask",
    "npm": "always-allow",
    "git": "ask"
  },
  "hooks": {
    "pre-bash": null,
    "post-bash": null,
    "pre-write": "npm run lint-staged",
    "post-write": null
  },
  "memory": [
    "../.claude-config/memory/coding-standards/typescript.md",
    "../.claude-config/memory/coding-standards/python.md"
  ],
  "enabledSkills": [
    "angular-component",
    "django-api",
    "clean-code-review"
  ],
  "customSettings": {
    "autoSave": true,
    "gitAutoStage": false,
    "verbose": false,
    "lintOnSave": true,
    "formatOnSave": true,
    "testOnCommit": true
  },
  "tools": {
    "packageManager": "npm",
    "linter": "eslint",
    "formatter": "prettier",
    "bundler": "vite"
  }
}
